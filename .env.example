# Local default uses SQLite. For Docker PostgreSQL, use the URL below.
DATABASE_URL=sqlite:///./bondalorians.db
# DATABASE_URL=postgresql+psycopg://bondalorians:bondalorians@localhost:5432/bondalorians

# Optional: enables Mistral-generated narrative. Pricing remains deterministic.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
